{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AuthURL": "https://localhost:7032"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customer/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "authserver-route": {
        "ClusterId": "authserver-cluster",
        "Match": {
          "Path": "/api/account/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "customer-cluster": {
        "Destinations": {
          "customer-server": {
            "Address": "https://localhost:7120"
          }
        }
      },
      "authserver-cluster": {
        "Destinations": {
          "authserver-server": {
            "Address": "https://localhost:7032"
          }
        }
      }
      }
    }
}
