{
  "Serilog": {
    "MinimumLevel": {
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:dd-MM HH:mm:ss} {Level:u3}]|{SourceContext}|{NewLine} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rolledOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:dd-MM HH:mm:ss} {Level:u3}]|{SourceContext}|{NewLine} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "RabbitMqConfig": {
    "Server": "localhost",
    "Username": "guest",
    "Password": "guest"
  },


  "TenantSetting": {
    "Defaults": {
      "DBProvider": "Sql",
      "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=CustomersManagmentDbShared;User Id=sa;Password=StrongPassword123!;TrustServerCertificate=true;Encrypt=false;"
    },
    "Tenants": [
      {
        "Name": "Tenant1",
        "TenantId": "Tenant1",
        "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=CustomersManagmentDbTenant1;User Id=sa;Password=StrongPassword123!;TrustServerCertificate=true;Encrypt=false;"
      },
      {
        "Name": "Tenant2",
        "TenantId": "Tenant2",
        "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=CustomersManagmentDbTenant2;User Id=sa;Password=StrongPassword123!;TrustServerCertificate=true;Encrypt=false;"
      },
      {
        "Name": "Tenant3",
        "TenantId": "Tenant3"
      },
      {
        "Name": "SharedTenant",
        "TenantId": "SharedTenant"
      }
    ]
  }
}
