{
  "Serilog": {
    "MinimumLevel": {
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:dd-MM HH:mm:ss} {Level:u3}]|{SourceContext}|{NewLine} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rolledOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:dd-MM HH:mm:ss} {Level:u3}]|{SourceContext}|{NewLine} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    //"DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=CustomersManagmentDb;User Id=sa;Password=Password123!;TrustServerCertificate=true;Encrypt=false",
    "DefaultConnection": "Server=host.docker.internal,1433;Database=CustomersManagmentDb;User Id=sa;Password=StrongPassword123!;TrustServerCertificate=true;Encrypt=false;Connection Timeout=30",
    //"DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Database=CustomersManagmentDb;Trusted_Connection=True;",
    "key": "this is my secret key abdo saad key"
  },
  "MongoDbSetting": {
    "ConnectionString": "mongodb://admin:Password123!@mongo:27017",
    "DatabaseName": "CustomersManagment"
  },
  "DatabaseProvidor": "sql",
  "RabbitMqConfig": {
    "Server": "localhost",
    "Username": "guest",
    "Password": "guest"
  }
}
